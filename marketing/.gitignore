# Raw WAV source for the soundtrack — heavy (~12 MB) and only needed to
# regenerate the compressed m4a via scripts/build-audio.mjs. The m4a output
# is committed; keep a local copy of the WAV if you need to re-encode.
assets/audio/*.wav
