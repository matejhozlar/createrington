{
  "name": "createrington-marketing",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Remotion marketing video for Createrington (Cogs & Steam)",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "predev": "node scripts/sync-assets.mjs",
    "prebuild": "node scripts/sync-assets.mjs",
    "prebuild:webm": "node scripts/sync-assets.mjs",
    "prepreview": "node scripts/sync-assets.mjs",
    "dev": "remotion studio",
    "build": "remotion render CreateringtonPromo out/createrington-promo.mp4 --scale=2 --crf=16",
    "build:fast": "remotion render CreateringtonPromo out/createrington-promo.mp4 --crf=16",
    "build:web": "remotion render CreateringtonPromo out/createrington-promo-web.mp4 --crf=23 --pixel-format=yuv420p",
    "build:webm": "remotion render CreateringtonPromo out/createrington-promo.webm --codec=vp9 --scale=2 --crf=16",
    "build:prores": "remotion render CreateringtonPromo out/createrington-promo.mov --codec=prores --prores-profile=4444 --scale=2",
    "preview": "remotion preview",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.350",
    "@remotion/fonts": "^4.0.350",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "^4.0.350"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "^5.6.3"
  }
}
