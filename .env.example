# =============================================================================
# Server
# =============================================================================
PORT=5001
NODE_ENV=development

# =============================================================================
# Database (PostgreSQL via Docker on port 5433)
# =============================================================================
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=createrington_db
DB_PASSWORD=postgres
DB_PORT=5433

# =============================================================================
# SFTP - Cogs & Steam
# Used to read player stats and manage the whitelist file on the game server.
# =============================================================================
COGS_AND_STEAM_SFTP_HOST=
COGS_AND_STEAM_SFTP_PORT=2022
COGS_AND_STEAM_SFTP_USER=
COGS_AND_STEAM_SFTP_PASS=
COGS_AND_STEAM_SFTP_STATS_PATH=./world/stats

# =============================================================================
# Discord
# =============================================================================
DISCORD_GUILD_ID=

# Bots
DISCORD_MAIN_BOT_ID=
DISCORD_MAIN_BOT_WEBHOOK_ID=
DISCORD_MAIN_BOT_TOKEN=
DISCORD_WEB_BOT_ID=
DISCORD_WEB_BOT_TOKEN=

# OAuth
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI_DEV=http://localhost:3000
DISCORD_OAUTH_REDIRECT_URI_PROD=https://create-rington.com

# =============================================================================
# Auth (JWT + refresh tokens)
# =============================================================================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
REFRESH_COOKIE_NAME=crt_refresh

# =============================================================================
# Minecraft Servers
# =============================================================================
COGS_AND_STEAM_SERVER_IP=0.0.0.0
COGS_AND_STEAM_SERVER_PORT=26980
LOCAL_SERVER_IP_ADDRESS=127.0.0.1
PLAYER_LIMIT=100

# RCON
COGS_AND_STEAM_RCON_PORT=25583
COGS_AND_STEAM_RCON_PASSWORD=

# =============================================================================
# URLs
# =============================================================================
WEBSITE_URL=https://dev.create-rington.com
ADMIN_PANEL_URL=https://dev.create-rington.com/login-admin/
ASSETS_URL=https://assets.create-rington.com
MAP_URL=https://dev.create-rington.com/blue-map

# =============================================================================
# Puppeteer (internal rendering for embeds/images)
# =============================================================================
PUPPETEER_SECRET=
# Optional - path to Chromium binary (omit to use bundled)
PUPPETEER_EXECUTABLE_PATH=
# Optional - base URL for Puppeteer to render pages from
PUPPETEER_BASE_URL=http://localhost:3000

# =============================================================================
# Playtime sync (optional - forwards playtime events to another environment)
# =============================================================================
PLAYTIME_SYNC_TARGET_URL=
PLAYTIME_SYNC_SECRET=

# =============================================================================
# CurseForge (optional - enables mod search in changelog builder)
# =============================================================================
CURSEFORGE_API_KEY=

# =============================================================================
# AI / OpenAI (used for crypto market news generation)
# =============================================================================
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# =============================================================================
# Maintenance (optional)
# When set, the maintenance service uses local filesystem instead of SFTP.
# Point to the Minecraft server data directory on the same machine.
# When absent, maintenance falls back to SFTP (production only).
# =============================================================================
# MAINTENANCE_LOCAL_PATH=/opt/infrastructure/mc-test/data

# =============================================================================
# Stripe (optional - enables donation features)
# =============================================================================
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# =============================================================================
# Email (used for waitlist notifications)
# =============================================================================
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_ADDRESS=
EMAIL_PASS=
