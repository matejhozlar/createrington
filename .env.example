# =============================================================================
# Server
# =============================================================================
PORT=5001
NODE_ENV=development

# =============================================================================
# Database (PostgreSQL via Docker on port 5433)
# =============================================================================
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=createrington_db
DB_PASSWORD=postgres
DB_PORT=5433

# =============================================================================
# SFTP - Cogs & Steam
# Used to read player stats and manage the whitelist file on the game server.
# =============================================================================
COGS_AND_STEAM_SFTP_HOST=
COGS_AND_STEAM_SFTP_PORT=2022
COGS_AND_STEAM_SFTP_USER=
COGS_AND_STEAM_SFTP_PASS=
COGS_AND_STEAM_SFTP_STATS_PATH=./world/stats

# =============================================================================
# Discord
# =============================================================================
DISCORD_GUILD_ID=

# Bots
DISCORD_MAIN_BOT_ID=
DISCORD_MAIN_BOT_WEBHOOK_ID=
DISCORD_MAIN_BOT_TOKEN=
DISCORD_WEB_BOT_ID=
DISCORD_WEB_BOT_TOKEN=

# OAuth
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI_DEV=http://localhost:3000
DISCORD_OAUTH_REDIRECT_URI_PROD=https://createrington.com

# =============================================================================
# Auth (JWT + refresh tokens)
# =============================================================================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
REFRESH_COOKIE_NAME=crt_refresh
ACCESS_COOKIE_NAME=crt_access

# =============================================================================
# Cross-subdomain SSO (optional — leave empty in dev to disable entirely)
# When configured, exposes /api/auth/sso/start + /api/auth/sso/callback so
# other subdomain apps (e.g. sandbox.createrington.com) can authenticate
# against this instance. The access token is also exposed as a cookie scoped
# to COOKIE_DOMAIN so consumers can read it without their own token storage.
#
# Setup checklist for prod:
# 1. Set COOKIE_DOMAIN to the parent domain shared with consumers
# 2. Set SSO_CALLBACK_URL and add the same value as an OAuth2 redirect URI
#    in the Discord developer portal
# 3. Add allowed return-to patterns (regex) and CORS origins
# =============================================================================
# Parent domain for refresh + access cookies (e.g. .createrington.com).
# Empty = host-only cookies (existing behavior, no SSO).
COOKIE_DOMAIN=
# Server-side OAuth callback URL (must be registered in the Discord portal)
SSO_CALLBACK_URL=
# Comma-separated regex patterns. The /api/auth/sso/start `return_to` query
# param is rejected unless it matches at least one pattern.
# Example: ^https://[a-z0-9-]+\.createrington\.com(/.*)?$
SSO_RETURN_TO_WHITELIST=
# Comma-separated origins allowed to call the API with credentials
# (needed for the cross-origin /api/auth/refresh call from consumers).
# Example: https://sandbox.createrington.com,https://panel.createrington.com
SSO_CORS_ORIGINS=

# =============================================================================
# Minecraft Servers
# =============================================================================
COGS_AND_STEAM_SERVER_IP=0.0.0.0
COGS_AND_STEAM_SERVER_PORT=26980
LOCAL_SERVER_IP_ADDRESS=127.0.0.1
PLAYER_LIMIT=100

# RCON
COGS_AND_STEAM_RCON_PORT=25583
COGS_AND_STEAM_RCON_PASSWORD=

# =============================================================================
# URLs
# =============================================================================
WEBSITE_URL=https://dev.createrington.com
ADMIN_PANEL_URL=https://dev.createrington.com/login-admin/
ASSETS_URL=https://assets.createrington.com
MAP_URL=https://dev.createrington.com/blue-map

# =============================================================================
# Puppeteer (internal rendering for embeds/images)
# =============================================================================
PUPPETEER_SECRET=
# Optional - path to Chromium binary (omit to use bundled)
PUPPETEER_EXECUTABLE_PATH=
# Optional - base URL for Puppeteer to render pages from
PUPPETEER_BASE_URL=http://localhost:3000

# =============================================================================
# Playtime sync (optional - forwards playtime events to another environment)
# =============================================================================
PLAYTIME_SYNC_TARGET_URL=
PLAYTIME_SYNC_SECRET=

# =============================================================================
# CurseForge (optional - enables mod search in changelog builder)
# =============================================================================
CURSEFORGE_API_KEY=

# =============================================================================
# AI / OpenAI (optional - used for crypto market news generation)
# Omit the API key to disable AI features (e.g. in dev deployments)
# =============================================================================
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# =============================================================================
# MC Server local path (optional)
# When set, services (maintenance, structure pack rotation) use local filesystem
# instead of SFTP. Point to the Minecraft server data directory on the same machine.
# When absent, these services fall back to SFTP (production only).
# =============================================================================
# MC_SERVER_LOCAL_PATH=/opt/infrastructure/mc-test/data

# =============================================================================
# Stripe (optional - enables donation features)
# =============================================================================
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# =============================================================================
# Email (used for waitlist notifications)
# =============================================================================
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_ADDRESS=
EMAIL_PASS=
