# =============================================================================
# Createrington — environment variables
#
# Three sections below:
#   1. Required (dev + prod)        — fill these in to boot the app locally
#   2. Required for production only — leave blank in dev
#   3. Optional (feature flags)     — enables individual integrations
#
# Copying this file to .env and filling in section 1 is enough to run
# `pnpm dev`. Section 2 vars are validated only when NODE_ENV=production
# AND WEBSITE_URL is not localhost / dev.* (real prod deployments).
# =============================================================================


# =============================================================================
# 1. REQUIRED (dev + prod)
# =============================================================================

# --- Server -----------------------------------------------------------------
PORT=5001
NODE_ENV=development

# --- Database (PostgreSQL via Docker on port 5433) --------------------------
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=createrington_db
DB_PASSWORD=postgres
DB_PORT=5433

# --- Discord ----------------------------------------------------------------
DISCORD_GUILD_ID=
DISCORD_MAIN_BOT_ID=
DISCORD_MAIN_BOT_WEBHOOK_ID=
DISCORD_MAIN_BOT_TOKEN=
DISCORD_WEB_BOT_ID=
DISCORD_WEB_BOT_TOKEN=

# --- Discord OAuth ----------------------------------------------------------
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI_DEV=http://localhost:3000

# --- Auth (JWT + refresh tokens) --------------------------------------------
# JWT_ACCESS_SECRET must be at least 32 characters. Use any random string in
# dev — don't reuse the production secret.
JWT_ACCESS_SECRET=dev_only_jwt_access_secret_change_me_in_prod
# MOD_JWT_SECRET signs the JWTs that Minecraft mod hosts self-issue. Must be
# at least 32 characters AND must differ from JWT_ACCESS_SECRET — sharing
# them would let a compromised mod host mint admin web sessions.
MOD_JWT_SECRET=dev_only_mod_jwt_secret_change_me_in_prod
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
REFRESH_COOKIE_NAME=crt_refresh
ACCESS_COOKIE_NAME=crt_access

# Discord ID of the sole owner — gates the owner-only admin management panel.
# Must be a Discord snowflake (17-20 digits).
OWNER_DISCORD_ID=

# --- URLs (point these at your local dev URLs) -----------------------------
WEBSITE_URL=http://localhost:3000
ADMIN_PANEL_URL=http://localhost:3000/login-admin/
ASSETS_URL=https://assets.createrington.com
MAP_URL=http://localhost:3000/blue-map
# Local Vite dev origin, used for CORS/CSRF allowlists in development only
# (NODE_ENV !== production). Defaults to http://localhost:3000 if unset.
DEV_CLIENT_ORIGIN=http://localhost:3000


# =============================================================================
# 2. REQUIRED FOR PRODUCTION ONLY
# Leave blank in dev. Validation re-requires these only when
# NODE_ENV=production AND WEBSITE_URL is not localhost / dev.*.
# =============================================================================

# --- SFTP — Cogs & Steam ----------------------------------------------------
# Used to read player stats and manage the whitelist file on the live game
# server. Gated behind isSftpAllowed() — never opens a connection in dev.
COGS_AND_STEAM_SFTP_HOST=
COGS_AND_STEAM_SFTP_PORT=2022
COGS_AND_STEAM_SFTP_USER=
COGS_AND_STEAM_SFTP_PASS=
COGS_AND_STEAM_SFTP_STATS_PATH=./world/stats

# --- Minecraft RCON ---------------------------------------------------------
# RCON connections never open in dev (no real game server to talk to).
COGS_AND_STEAM_RCON_PASSWORD=

# --- Discord OAuth (prod redirect) ------------------------------------------
# Only consumed when NODE_ENV=production.
DISCORD_OAUTH_REDIRECT_URI_PROD=https://createrington.com

# --- Puppeteer (internal rendering for embeds/images) ----------------------
# Required for the render endpoints; render routes reject empty secrets, so
# leaving this blank in dev just disables image-render slash commands.
# Must be at least 32 characters in production.
PUPPETEER_SECRET=

# --- Email (Resend — used for waitlist notifications) ----------------------
# Email sends are skipped (with a warning) when this is not set.
RESEND_API_KEY=
# Optional — defaults to admin@createrington.com. Must be on a domain
# verified in the Resend dashboard.
RESEND_FROM_EMAIL=

# --- Storage ---------------------------------------------------------------
# Absolute (or CWD-relative) path to a directory the server can write to.
# Holds ticket transcripts today; other runtime artifacts may join later.
# Defaults to ./storage when unset (good for dev). Set to a path outside
# the checkout in prod (e.g. /opt/createrington-dev/storage).
STORAGE_PATH=


# =============================================================================
# 3. OPTIONAL (feature flags)
# Each block enables an integration. Safe to leave unset — the corresponding
# feature is disabled at runtime.
# =============================================================================

# --- Minecraft Servers (defaults shown; override only if you need to) ------
# COGS_AND_STEAM_SERVER_IP=0.0.0.0
# COGS_AND_STEAM_SERVER_PORT=26980
# LOCAL_SERVER_IP_ADDRESS=127.0.0.1
# COGS_AND_STEAM_RCON_PORT=25583
# PLAYER_LIMIT=100

# --- Cross-subdomain SSO ---------------------------------------------------
# When configured, exposes /api/auth/sso/start + /api/auth/sso/callback so
# other subdomain apps (e.g. sandbox.createrington.com) can authenticate
# against this instance.
#
# Setup checklist for prod:
# 1. Set COOKIE_DOMAIN to the parent domain shared with consumers
# 2. Set SSO_CALLBACK_URL and add the same value as an OAuth2 redirect URI
#    in the Discord developer portal
# 3. Add allowed return-to patterns (regex) and CORS origins
COOKIE_DOMAIN=
SSO_CALLBACK_URL=
# Comma-separated list (e.g. https://sandbox.createrington.com,https://panel.createrington.com)
SSO_CORS_ORIGINS=
# Comma-separated origins that complete SSO via a one-time code in the redirect
# (skin-api) instead of the parent-domain cookie. Auto-added to the return-to
# allowlist, so they need not also be in SSO_CORS_ORIGINS. Set as a pair with
# INTERNAL_API_SHARED_SECRET below (e.g. https://api.createrington.com).
SSO_CODE_EXCHANGE_ORIGINS=

# --- Puppeteer overrides ---------------------------------------------------
# Path to Chromium binary (omit to use bundled)
PUPPETEER_EXECUTABLE_PATH=
# Base URL Puppeteer renders against (defaults to WEBSITE_URL)
PUPPETEER_BASE_URL=http://localhost:3000

# --- Playtime sync (forwards playtime events to another environment) -------
PLAYTIME_SYNC_TARGET_URL=
PLAYTIME_SYNC_SECRET=

# --- Internal skin-api bridge ----------------------------------------------
# Shared secret (32+ chars) authenticating server-to-server calls from skin-api
# to /api/internal/* (sso-exchange). Must match the value configured in
# skin-api. Internal skin-api routes only mount when this is set. Distinct from
# PLAYTIME_SYNC_SECRET (different trust boundary).
INTERNAL_API_SHARED_SECRET=

# --- Claude automation proxy (admin chat widget) ---------------------------
CLAUDE_API_URL=
ADMIN_CHAT_SECRET=

# --- CurseForge (mod search in changelog builder) --------------------------
CURSEFORGE_API_KEY=

# --- Sandbox (publish reports from the sandbox server) ---------------------
# Shared secret (32+ chars) the sandbox presents as a bearer token when it
# reports a published release from a background job. Omit to refuse those.
SANDBOX_SERVICE_TOKEN=

# --- AI / OpenAI (crypto market news generation) ---------------------------
# Omit the API key to disable AI features entirely.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# --- MC Server local path --------------------------------------------------
# When set, services (maintenance, structure pack rotation) use the local
# filesystem instead of SFTP. Point to the Minecraft server data directory
# on the same machine. For the local Docker server (see
# docker/mc/docker-compose.yml) this is the bind-mounted data directory.
# MC_SERVER_LOCAL_PATH=./docker/mc/data

# --- Local Minecraft Docker server -----------------------------------------
# Consumed by docker/mc/docker-compose.yml (pnpm mc:up). All optional; defaults shown.
# MC_MEMORY=4G
# MC_NEOFORGE_VERSION=21.1.222
# MC_RCON_PASSWORD=dev-rcon
# MC_RCON_PORT=25575
# Online mode mirrors production (real account auth + UUIDs). Set FALSE to
# join locally without a premium account.
# MC_ONLINE_MODE=TRUE

# --- Stripe (donation features) --------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
