{
  "name": "@createrington/server",
  "version": "1.17.0",
  "description": "",
  "private": true,
  "license": "UNLICENSED",
  "main": "server.ts",
  "exports": {
    "./trpc": {
      "types": "./dist/server/src/trpc/router.d.ts"
    },
    "./trpc/panel": {
      "types": "./dist/server/src/trpc/routers/consumers/panel/index.d.ts"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-watch.mjs",
    "dev:types": "tsc --emitDeclarationOnly --watch & tsc-alias --watch",
    "build": "tsc && tsc-alias && pnpm post-build && pnpm build:copy-assets",
    "build:copy-assets": "copyfiles -u 1 \"src/**/*.html\" \"src/**/*.png\" \"src/**/*.jpg\" \"src/**/*.svg\" \"src/**/*.json\" dist/server/src",
    "post-build": "tsx src/scripts/tools/post-build.ts",
    "start": "node dist/server/src/server.js",
    "build:types": "tsc --declaration --emitDeclarationOnly && tsc-alias",
    "typecheck": "tsc --noEmit",
    "generate": "tsx src/scripts/generate.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "util:generate-structure": "node src/scripts/tools/generate-structure.js",
    "util:env-gen": "tsx src/scripts/env/env-gen.ts",
    "util:env-find": "tsx src/scripts/env/env-gen.ts",
    "util:import-find": "node src/scripts/dependency/import-find.js",
    "util:schema-info": "node src/scripts/db/get-table-info.js",
    "util:deploy-commands": "tsx src/discord/deployers/command-deployer.ts",
    "util:generate-command-docs": "tsx src/scripts/discord/generate-command-docs.ts",
    "util:generate-command-docs:json": "tsx src/scripts/discord/generate-command-docs.ts --json",
    "util:generate-command-docs:md": "tsx src/scripts/discord/generate-command-docs.ts --md",
    "util:generate-api-docs": "tsx src/scripts/api/generate-api-docs.ts",
    "util:generate-mod-api": "tsx src/scripts/api/generate-mod-api.ts",
    "util:scrape-discord": "tsx src/scripts/discord/scrape-entities.ts",
    "util:sync-nicknames": "tsx src/scripts/discord/sync-nicknames.ts",
    "util:db-migrate-users": "tsx src/scripts/db/migration/migrate-users.ts",
    "generate:db-query-system": "tsx src/scripts/db/generate-query-system.ts",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e"
  },
  "keywords": [],
  "author": "Matej Hozlar",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/socket.io": "^3.0.1",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitest/ui": "^4.0.16",
    "chalk": "^5.6.2",
    "chokidar": "^3.6.0",
    "copyfiles": "^2.4.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "ora": "^9.0.0",
    "trpc-ui": "npm:trpc-ui-zod4@^1.1.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@createrington/logger": "^0.1.2",
    "@createrington/shared": "workspace:*",
    "@trpc/server": "^11.1.0",
    "axios": "^1.15.2",
    "canvas": "^3.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "discord-html-transcripts": "^3.2.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "minecraft-server-util": "^5.4.4",
    "multer": "^2.0.2",
    "openai": "^6.27.0",
    "pg": "^8.16.3",
    "puppeteer-core": "^24.40.0",
    "rcon-client": "^4.2.5",
    "resend": "^6.12.2",
    "socket.io": "^4.8.3",
    "ssh2-sftp-client": "^12.0.1",
    "stripe": "^20.4.1",
    "winston": "^3.18.3",
    "zod": "^4.1.13"
  }
}
