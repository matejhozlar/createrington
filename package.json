{
  "name": "createrington",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "undici": "^6.23.0",
    "discord-html-transcripts": {
      "undici": "^6.23.0"
    },
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "fast-xml-parser": ">=5.3.4"
  },
  "scripts": {
    "generate": "npm run generate --workspace=@createrington/server && npm run build:shared && npm run typecheck",
    "typecheck": "npm run build:types --workspace=@createrington/server && npm run typecheck --workspaces --if-present",
    "typecheck:shared": "npm run typecheck --workspace=@createrington/shared",
    "typecheck:server": "npm run typecheck --workspace=@createrington/server",
    "typecheck:client": "npm run typecheck --workspace=@createrington/client",
    "dev:client": "npm run dev --workspace=@createrington/client",
    "dev:server": "npm run dev --workspace=@createrington/server",
    "dev:types": "npm run dev:types --workspace=@createrington/server",
    "dev": "concurrently -n \"server,client,types\" -c \"blue,green,yellow\" \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:types\"",
    "build:client": "npm run build --workspace=@createrington/client",
    "build:server": "npm run build --workspace=@createrington/server",
    "build:shared": "npm run build --workspace=@createrington/shared",
    "build": "npm run generate && npm run build:shared && npm run build:server && npm run build:client && npm run build:dist",
    "build:dist": "node scripts/build-dist.js",
    "start": "node dist/server/src/server.js",
    "lint": "npm run lint --workspace=@createrington/client",
    "lint:client": "npm run lint --workspace=@createrington/client",
    "test": "npm run test --workspace=@createrington/server",
    "test:unit": "npm run test:unit --workspace=@createrington/server",
    "test:integration": "npm run test:integration --workspace=@createrington/server",
    "deploy-commands": "npm run util:deploy-commands --workspace=@createrington/server",
    "scrape-discord": "npm run util:scrape-discord --workspace=@createrington/server",
    "dump-schema": "npm run util:db-dump-schema --workspace=@createrington/server",
    "setup": "npm ci && npm run util:scrape-discord --workspace=@createrington/server && npm run db:up && npm run generate",
    "db:up": "docker-compose -f db/docker-compose.yml up -d postgres",
    "db:down": "docker-compose -f db/docker-compose.yml down",
    "db:logs": "docker-compose -f db/docker-compose.yml logs -f postgres",
    "db:reset": "docker-compose -f db/docker-compose.yml down -v && docker-compose -f db/docker-compose.yml build && docker-compose -f db/docker-compose.yml up -d --wait postgres && npm run db:seed",
    "db:shell": "docker exec -it createrington-db psql -U postgres -d createrington_db",
    "db:destroy": "docker-compose -f db/docker-compose.yml down -v --rmi all",
    "db:seed": "psql -h localhost -p 5433 -U postgres -d createrington_db -f db/data/test-data.sql",
    "db:setup": "npm run db:up && sleep 5 && npm run db:up",
    "pgadmin": "docker-compose -f db/docker-compose.yml up -d pgadmin"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.893.0",
    "@aws-sdk/client-sso": "^3.893.0"
  }
}
