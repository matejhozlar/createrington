{
  "name": "createrington",
  "version": "1.18.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "undici": "^6.24.0",
      "discord-html-transcripts>undici": "^6.24.0",
      "flatted": "^3.4.2",
      "socket.io-parser": "^4.2.6",
      "dompurify": "^3.3.2",
      "fast-xml-parser": ">=5.3.4",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
      "lodash@>=4.0.0 <=4.17.23": "^4.18.0",
      "yaml@>=1.0.0 <1.10.3": "^1.10.3",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3",
      "brace-expansion@<1.1.13": "^1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "^2.0.3",
      "brace-expansion@>=4.0.0 <5.0.5": "^5.0.5",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "basic-ftp": "^5.3.1",
      "follow-redirects": ">=1.16.0",
      "svix>uuid": ">=14.0.0",
      "postcss@<8.5.10": "^8.5.10",
      "ip-address@<10.1.1": "^10.1.1"
    },
    "onlyBuiltDependencies": [
      "@infisical/cli",
      "@parcel/watcher",
      "canvas",
      "cpu-features",
      "esbuild",
      "protobufjs",
      "ssh2"
    ]
  },
  "scripts": {
    "generate": "pnpm --filter @createrington/server generate && pnpm build:shared && pnpm typecheck",
    "generate:ci": "pnpm --filter @createrington/server generate && pnpm build:shared",
    "typecheck": "pnpm --filter @createrington/server build:types && pnpm -r typecheck",
    "typecheck:shared": "pnpm --filter @createrington/shared typecheck",
    "typecheck:server": "pnpm --filter @createrington/server typecheck",
    "typecheck:client": "pnpm --filter @createrington/client typecheck",
    "dev:client": "pnpm --filter @createrington/client dev",
    "dev:server": "pnpm --filter @createrington/server dev",
    "dev:types": "pnpm --filter @createrington/server dev:types",
    "dev": "concurrently -n \"types,client,server\" -c \"yellow,green,blue\" \"pnpm dev:types\" \"pnpm dev:client\" \"pnpm dev:server\"",
    "build:client": "pnpm --filter @createrington/client build",
    "build:server": "pnpm --filter @createrington/server build",
    "build:shared": "pnpm --filter @createrington/shared build",
    "build:api-types": "pnpm --filter @createrington/api-types build",
    "release:api-types": "pnpm --filter @createrington/api-types release",
    "build": "pnpm generate && pnpm build:shared && pnpm build:server && pnpm build:client && pnpm build:dist",
    "build:dist": "node scripts/build-dist.js",
    "start": "node dist/server/src/server.js",
    "format": "prettier --write ./packages",
    "format:check": "prettier --check ./packages",
    "prepare": "husky",
    "lint": "pnpm -r lint",
    "lint:server": "pnpm --filter @createrington/server lint",
    "lint:client": "pnpm --filter @createrington/client lint",
    "test": "pnpm --filter @createrington/server test",
    "test:unit": "pnpm --filter @createrington/server test:unit",
    "test:integration": "pnpm --filter @createrington/server test:integration",
    "deploy-commands": "pnpm --filter @createrington/server util:deploy-commands",
    "generate-command-docs": "pnpm --filter @createrington/server util:generate-command-docs",
    "generate-command-docs:json": "pnpm --filter @createrington/server util:generate-command-docs:json",
    "generate-command-docs:md": "pnpm --filter @createrington/server util:generate-command-docs:md",
    "generate-api-docs": "pnpm --filter @createrington/server util:generate-api-docs",
    "generate-mod-api": "pnpm --filter @createrington/server util:generate-mod-api",
    "scrape-discord": "pnpm --filter @createrington/server util:scrape-discord",
    "sync-nicknames": "pnpm --filter @createrington/server util:sync-nicknames",
    "mint-session": "pnpm --filter @createrington/server util:mint-session",
    "db:generate": "pnpm --filter @createrington/server db:generate",
    "db:migrate": "pnpm --filter @createrington/server db:migrate",
    "setup": "pnpm install && pnpm --filter @createrington/server util:scrape-discord && pnpm db:up && pnpm generate",
    "db:up": "docker-compose -f db/docker-compose.yml up -d postgres",
    "db:down": "docker-compose -f db/docker-compose.yml down",
    "db:logs": "docker-compose -f db/docker-compose.yml logs -f postgres",
    "db:reset": "docker-compose -f db/docker-compose.yml down -v && docker-compose -f db/docker-compose.yml build && docker-compose -f db/docker-compose.yml up -d --wait postgres && pnpm db:migrate && pnpm db:seed",
    "db:shell": "docker exec -it createrington-db psql -U postgres -d createrington_db",
    "db:destroy": "docker-compose -f db/docker-compose.yml down -v --rmi all",
    "db:seed": "psql -h localhost -p 5433 -U postgres -d createrington_db -f db/data/test-data.sql",
    "db:setup": "pnpm db:up && sleep 5 && pnpm db:up",
    "pgadmin": "docker-compose -f db/docker-compose.yml up -d pgadmin",
    "kill-ports": "bash scripts/kill-ports.sh"
  },
  "devDependencies": {
    "@infisical/cli": "^0.43.84",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "packages/**/*.{ts,tsx,js,mjs,cjs,json,css,md}": "prettier --write"
  }
}
